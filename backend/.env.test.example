# Copy this file to .env.test and adjust values for your local environment.
# .env.test is git-ignored — never commit real credentials.
#
# Used exclusively by the pytest suite so tests never touch dev data
# (see backend/tests/conftest.py, which loads this before importing the app).

ENVIRONMENT=development
LOG_LEVEL=WARNING
DATABASE_URL=postgresql+psycopg://compintel_app:changeme@localhost:5432/compintel_test
BACKEND_CORS_ORIGINS=http://localhost:5173
