# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored — never commit real credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Set up in Phase 1A step 5 (local PostgreSQL setup). Placeholder until then.
DATABASE_URL=postgresql+psycopg://compintel_app:changeme@localhost:5432/compintel_dev

# Comma-separated list of origins allowed to call this API.
BACKEND_CORS_ORIGINS=http://localhost:5173
