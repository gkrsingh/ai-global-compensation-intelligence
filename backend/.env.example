# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored — never commit real credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Role/database created via the local PostgreSQL setup in Phase 1A step 5.
DATABASE_URL=postgresql+psycopg://compintel_app:changeme@localhost:5432/compintel_dev

# Comma-separated list of origins allowed to call this API.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Signs and verifies JWT access tokens. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the same value across dev/test/prod, and never commit a real one.
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
