# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored — never commit real credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Role/database created via the local PostgreSQL setup in Phase 1A step 5.
DATABASE_URL=postgresql+psycopg://compintel_app:changeme@localhost:5432/compintel_dev

# Comma-separated list of origins allowed to call this API.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Signs and verifies JWT access tokens. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the same value across dev/test/prod, and never commit a real one.
JWT_SECRET_KEY=changeme-generate-a-real-random-secret

# Powers Phase 8's AI-generated negotiation insight. AI_PROVIDER picks
# which one of the two configured providers below is actually used
# ("gemini" or "anthropic") - both stay fully wired regardless, so
# switching is a one-line change, not a code change. Both API keys are
# optional - the rest of the app (including the whole test suite, which
# mocks the provider and never calls a real API) works fine with both
# unset.
AI_PROVIDER=gemini

# Free tier suitable for personal-use volume. Get a real key at
# https://aistudio.google.com/apikey - never commit a real one.
GEMINI_API_KEY=changeme-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Get a real key at https://console.anthropic.com/ - never commit a real one.
ANTHROPIC_API_KEY=changeme-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
